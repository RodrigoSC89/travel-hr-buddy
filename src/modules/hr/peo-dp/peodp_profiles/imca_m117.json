{
  "version": "3.0",
  "standard": "IMCA M 117",
  "title": "The Training and Experience of Key DP Personnel",
  "authority": "International Marine Contractors Association",
  "lastUpdate": "2024-01-15",
  "revision": "Rev. 3 - October 2021",
  "sections": [
    {
      "id": "1",
      "title": "Introduction and Scope",
      "items": [
        {
          "id": "1.1",
          "code": "IMCA-M117-1.1",
          "requirement": "Application of Guidelines",
          "description": "These guidelines apply to all personnel involved in DP operations",
          "evidences": ["Policy document", "Training matrix"],
          "criticality": "major"
        }
      ]
    },
    {
      "id": "2",
      "title": "Definitions of Key DP Personnel",
      "items": [
        {
          "id": "2.1",
          "code": "IMCA-M117-2.1",
          "requirement": "Dynamic Positioning Operator (DPO)",
          "description": "Person qualified to operate the DP system",
          "evidences": ["DPO certificate", "Training records"],
          "criticality": "critical"
        },
        {
          "id": "2.2",
          "code": "IMCA-M117-2.2",
          "requirement": "Senior Dynamic Positioning Operator (SDPO)",
          "description": "Experienced DPO with supervisory responsibilities",
          "evidences": ["SDPO certificate", "Experience log"],
          "criticality": "critical"
        },
        {
          "id": "2.3",
          "code": "IMCA-M117-2.3",
          "requirement": "Master/OIM",
          "description": "Person with overall responsibility for DP operations",
          "evidences": ["Master certificate", "DP awareness training"],
          "criticality": "critical"
        }
      ]
    },
