{
  "version": "1.0.0",
  "description": "NAUTI ONE QA Specification - Interactivity & Completeness Contract",
  "global": {
    "must_have": [
      "no_dead_buttons",
      "crud_complete",
      "live_lists_search_filter_sort_page",
      "bulk_actions",
      "loading_success_error_retry",
      "empty_state_with_cta",
      "rbac_hide_or_explain",
      "audit_log_on_all_mutations",
      "export_respects_filters",
      "error_boundary_per_block",
      "correlation_id_every_request",
      "skeleton_loaders",
      "undo_for_destructive_actions",
      "auto_save_drafts",
      "contextual_help"
    ],
    "torture_tests": [
      "double_click_protection",
      "slow_network_handling",
      "offline_recovery",
      "401_403_handling",
      "500_timeout_handling",
      "large_dataset_1000_plus",
      "modal_close_without_save_warning",
      "undo_after_delete",
      "two_tabs_conflict_handling",
      "back_button_after_save",
      "rapid_form_submission",
      "concurrent_edits",
      "session_expiry_handling",
      "file_upload_cancel",
      "browser_refresh_during_action"
    ],
    "scoring": {
      "discovery": {
        "weight": 25,
        "criteria": [
          "clear_title_and_description",
          "primary_cta_visible",
          "empty_state_intelligent",
          "contextual_help_available",
          "user_understands_in_5_seconds"
        ]
      },
      "action": {
        "weight": 25,
        "criteria": [
          "primary_action_works",
          "secondary_actions_available",
          "crud_complete",
          "bulk_actions_available",
          "upload_attachments_when_applicable"
        ]
      },
      "feedback_control": {
        "weight": 25,
        "criteria": [
          "loading_states_visible",
          "success_confirmation",
          "error_messages_clear",
          "retry_available",
          "undo_available",
          "status_visible",
          "versioning_when_applicable"
        ]
      },
      "operational_confidence": {
        "weight": 25,
        "criteria": [
          "rbac_enforced",
          "audit_log_complete",
          "export_functional",
          "error_boundary_per_block",
          "correlation_id_tracked",
          "data_persistence_verified"
        ]
      }
    }
  },
  "modules": [
